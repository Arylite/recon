# Local development only: `cd backend && npm run dev` reads backend/.env.local, and keeps the data
# in memory when no Redis is configured. On Vercel these are project environment variables.
# Generate each secret with: openssl rand -hex 32 (at least 32 characters in production).

# App key baked into the APK (also the GitHub secret API_TOKEN used to build it).
API_TOKEN=
# Encrypts the Riot cookies and signs the tickets; losing it signs everyone out.
SECRET=
# Bearer secret of GET /cron/check (also the GitHub secret CRON_SECRET used by check.yml).
CRON_SECRET=
# Upstash Redis, added by the Vercel integration (leave empty locally for in-memory data).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set to false once everyone who should have an account has one.
# ALLOW_REGISTRATION=false
